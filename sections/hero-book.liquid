{{ 'section-hero-book.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign book = section.settings.product

  assign cover = section.settings.cover_image
  if cover == blank and book != blank
    assign cover = book.featured_image
  endif

  assign title = section.settings.title
  if title == blank and book != blank
    assign title = book.title
  endif

  assign author = section.settings.author
  if author == blank and book != blank
    assign author = 'by ' | append: book.vendor
  endif

  assign link = section.settings.button_link
  if link == blank and book != blank
    assign link = book.url
  endif

  # Animation follows the theme setting "Reveal sections on scroll".
  # First section on the page: CSS-only animation on load (no JS, so the cover
  # image paints right away). Lower down: Dawn's scroll-trigger in animations.js.
  assign animate = settings.animations_reveal_on_scroll
  assign trigger = ''
  if animate and section.index > 1
    assign trigger = ' scroll-trigger'
  endif

  assign delay = 120
-%}

<div class="hero-book{% if animate %} hero-book--animate{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="hero-book__grid{% if section.settings.image_position == 'right' %} hero-book__grid--image-right{% endif %}">
      <div class="hero-book__cover{{ trigger }}" data-reveal="cover">
        {%- if cover != blank -%}
          {%- if link != blank %}<a href="{{ link | escape }}" class="hero-book__cover-link" tabindex="-1" aria-hidden="true">{% endif -%}
          {{
            cover
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '360, 540, 720, 900, 1200',
              sizes: '(min-width: 990px) 38vw, (min-width: 750px) 42vw, 72vw',
              class: 'hero-book__cover-image',
              alt: cover.alt
          }}
          {%- if link != blank %}</a>{% endif -%}
        {%- else -%}
          <div class="hero-book__cover-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="hero-book__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hero-book__eyebrow{{ trigger }}" data-reveal style="--reveal-delay: {{ delay }}ms;">
            {{- section.settings.eyebrow | escape -}}
          </p>
          {%- assign delay = delay | plus: 80 -%}
        {%- endif -%}

        {%- if title != blank -%}
          <h1
            class="hero-book__title {{ section.settings.heading_size }}{{ trigger }}"
            data-reveal
            style="--reveal-delay: {{ delay }}ms;"
          >
            {{- title | escape -}}
          </h1>
          {%- assign delay = delay | plus: 80 -%}
        {%- endif -%}

        {%- if author != blank -%}
          <p class="hero-book__author{{ trigger }}" data-reveal style="--reveal-delay: {{ delay }}ms;">
            {{- author | escape -}}
          </p>
          {%- assign delay = delay | plus: 80 -%}
        {%- endif -%}

        {%- if section.settings.blurb != blank -%}
          <div class="hero-book__blurb rte{{ trigger }}" data-reveal style="--reveal-delay: {{ delay }}ms;">
            {{ section.settings.blurb }}
          </div>
          {%- assign delay = delay | plus: 80 -%}
        {%- endif -%}

        {%- if book != blank and section.settings.show_formats -%}
          <dl class="hero-book__formats{{ trigger }}" data-reveal style="--reveal-delay: {{ delay }}ms;">
            {%- for variant in book.variants -%}
              <div class="hero-book__format">
                <dt>{{ variant.title | escape }}</dt>
                <dd>{{ variant.price | money }}</dd>
              </div>
            {%- endfor -%}
          </dl>
          {%- assign delay = delay | plus: 80 -%}
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.note != blank -%}
          <div class="hero-book__actions{{ trigger }}" data-reveal style="--reveal-delay: {{ delay }}ms;">
            {%- if section.settings.button_label != blank -%}
              <a
                {% if link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ link | escape }}"
                {% endif %}
                class="button button--primary hero-book__button"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.note != blank -%}
              <p class="hero-book__note">{{ section.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Book hero",
  "tag": "section",
  "class": "section section-hero-book",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Book"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Book",
      "info": "Fills in the cover, title, author, formats and button link. The fields below override it."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "Leave empty to use the book's cover. Portrait images (2:3) look best."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Line above title",
      "default": "New this season"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave empty to use the book's title."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author line",
      "info": "Leave empty to use \"by\" plus the book's vendor."
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_formats",
      "label": "Show formats and prices",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Choose a format"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to the book."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note beside button",
      "default": "Hardcovers can be signed by the author."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Cover position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Book hero"
    }
  ]
}
{% endschema %}
